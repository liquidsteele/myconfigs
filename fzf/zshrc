# --- FIXES & AUTO VENV ---

# Função customizada para o Agnoster ler o nosso nome bonito
# Colocamos isto aqui para sobrescrever a função original do tema


function auto_venv_shell {
  local current_dir_name=$(basename "$PWD")

  # 1. Se estivermos num venv, verificar se saímos da pasta do projeto
  if [[ -n "$VIRTUAL_ENV" ]]; then
    # Se o caminho atual não começar pela pasta pai do venv, desativamos
    if [[ "$PWD" != "$(dirname "$VIRTUAL_ENV")"* ]]; then
      deactivate
      unset VIRTUAL_ENV_DISPLAY
    fi
  fi

  # 2. Tentar detetar novo ambiente se nenhum estiver ativo
  if [[ -z "$VIRTUAL_ENV" ]]; then
    # --- Lógica UV ---
    if [[ -f uv.lock ]] || ([[ -f pyproject.toml ]] && [[ -d .venv ]] && [[ ! -f poetry.lock ]]); then
      if [[ -d .venv ]]; then
        source ".venv/bin/activate"
        # Exportamos o PATH REAL para o VS Code ficar feliz
        export VIRTUAL_ENV="$PWD/.venv"
        # Exportamos o NOME ESTÉTICO para o nosso prompt_virtualenv acima
        export VIRTUAL_ENV_DISPLAY="($current_dir_name-uv)"
      fi

    # --- Lógica POETRY ---
    elif [[ -f poetry.lock ]]; then
      local venv_path=$(poetry env info --path 2>/dev/null)
      if [[ -n "$venv_path" ]]; then
        source "$venv_path/bin/activate"
        export VIRTUAL_ENV="$venv_path"
        export VIRTUAL_ENV_DISPLAY="($(basename "$venv_path"))"
      fi
    fi
  fi
}

autoload -U add-zsh-hook
add-zsh-hook chpwd auto_venv_shell

